{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChatControl timeline event",
  "type": "object",
  "required": ["date", "title", "type", "source_url"],
  "properties": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "title": { "type": "string" },
    "type": {
      "type": "string",
      "enum": [
        "EU_sluzbeno", "glasovanje", "hr_mediji", "izjava_politicara",
        "okrugli_stol", "civilno_drustvo", "medjunarodni_kontekst", "drustvene_mreze"
      ]
    },
    "actor": { "type": "string" },
    "summary": { "type": "string" },
    "source_url": { "type": "string", "format": "uri" },
    "source_name": { "type": "string" },
    "eu_ref_url": { "type": ["string", "null"], "format": "uri" },
    "verified": { "type": "boolean" }
  }
}
